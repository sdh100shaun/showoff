{
  "name": "serverless-kb",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless RAG retrieval service: S3 documents, Amazon Bedrock Knowledge Bases, Amazon S3 Vectors (AWS CDK, TypeScript)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "synth": "cdk synth --quiet",
    "deploy": "cdk deploy",
    "check:secrets": "bash scripts/check-secrets.sh",
    "verify": "npm run build && npm run lint && npm test && npm run check:secrets"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1144.0",
    "aws-cdk-lib": "^2.272.0",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-sdk/client-bedrock-agent": "^3.1146.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1146.0",
    "zod": "^4.6.5"
  }
}
